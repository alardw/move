{
  "name": "move",
  "version": "0.1.50",
  "description": "Animated UI component library built on Radix UI primitives",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./system.css": "./dist/styles/system.css",
    "./styles/*": "./dist/styles/*"
  },
  "bin": {
    "move": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "recipes",
    "skills"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "pack": "node -e \"const f='package.json',p=JSON.parse(require('fs').readFileSync(f));const v=p.version.split('.');v[2]=+v[2]+1;p.version=v.join('.');require('fs').writeFileSync(f,JSON.stringify(p,null,2)+'\\n');console.log('v'+p.version)\" && npm run build && mkdir -p release && npm pack --pack-destination release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest --config vitest.browser.config.ts run",
    "check:spec-drift": "node scripts/checks/spec-drift.mjs",
    "check:family-popup": "node scripts/checks/family-popup.mjs",
    "check:family-modal": "node scripts/checks/family-modal.mjs",
    "check:family-disclosure": "node scripts/checks/family-disclosure.mjs",
    "check:cross-component-drift": "node scripts/checks/cross-component-drift.mjs",
    "check:animation-capabilities": "node scripts/checks/animation-capabilities.mjs",
    "check:recipes": "node scripts/checks/recipe-purity.mjs",
    "check:css-tokens": "node scripts/checks/css-tokens.mjs",
    "check:component-conformance": "node scripts/checks/component-conformance.mjs",
    "check:spec-tokens": "node scripts/checks/spec-tokens.mjs",
    "check:strict-props": "node scripts/checks/strict-props.mjs",
    "check:recipe-spec-drift": "node scripts/checks/recipe-spec-drift.mjs",
    "check:all": "npm run check:spec-drift && npm run check:family-popup && npm run check:family-modal && npm run check:family-disclosure && npm run check:cross-component-drift && npm run check:animation-capabilities && npm run check:recipes && npm run check:css-tokens && npm run check:component-conformance && npm run check:spec-tokens && npm run check:strict-props && npm run check:recipe-spec-drift",
    "spec-diff": "tsx scripts/spec-diff/cli.mjs diff",
    "spec-snapshot": "tsx scripts/spec-diff/cli.mjs snapshot --from src/components"
  },
  "peerDependencies": {
    "animejs": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "animejs": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.560.0",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "radix-ui": "^1.1.0"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "radix",
    "animation",
    "accessible"
  ],
  "license": "MIT"
}
