{
  "name": "move",
  "version": "0.1.55",
  "description": "Animated UI component library built on Radix UI primitives",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./spec": {
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./system.css": "./dist/styles/system.css",
    "./styles/*": "./dist/styles/*",
    "./scaffold/*": "./scaffold/*"
  },
  "bin": {
    "move": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "checks",
    "dist",
    "llms.txt",
    "move.api.json",
    "scaffold",
    "skills"
  ],
  "scripts": {
    "gen:api": "node scripts/generate-api.mjs",
    "gen:tokens": "tsx scripts/generate-tokens.mjs",
    "check:api-surface": "node scripts/generate-api.mjs --check",
    "check:tokens-surface": "tsx scripts/generate-tokens.mjs --check",
    "build": "npm run clean && node scripts/generate-api.mjs && vite build",
    "dev": "vite build --watch",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "npm run build && npm run check:dist-packaging",
    "pack": "node -e \"const f='package.json',p=JSON.parse(require('fs').readFileSync(f));const v=p.version.split('.');v[2]=+v[2]+1;p.version=v.join('.');require('fs').writeFileSync(f,JSON.stringify(p,null,2)+'\\n');console.log('v'+p.version)\" && npm run build && npm run check:dist-packaging && mkdir -p release && npm pack --pack-destination release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest --config vitest.browser.config.ts run",
    "check:spec-drift": "node scripts/checks/spec-drift.mjs",
    "check:dist-packaging": "node scripts/checks/dist-packaging.mjs",
    "check:skill-refs": "node scripts/checks/skill-refs.mjs",
    "check:palette-tokens": "node scripts/checks/palette-tokens.mjs",
    "check:api-compound-shape": "node scripts/checks/api-compound-shape.mjs",
    "check:i18n-literals": "node scripts/checks/i18n-literals.mjs",
    "check:escape-hatch": "node scripts/checks/escape-hatch.mjs",
    "check:barrel-completeness": "node scripts/checks/barrel-completeness.mjs",
    "check:design-pattern-conformance": "vitest run patterns/design-patterns.validate.test.ts",
    "check:keyboard-entry": "vitest run checks/keyboard-entry.validate.test.tsx",
    "check:field-naming": "vitest run checks/field-naming.validate.test.tsx",
    "check:family-popup": "node scripts/checks/family-popup.mjs",
    "check:family-modal": "node scripts/checks/family-modal.mjs",
    "check:family-disclosure": "node scripts/checks/family-disclosure.mjs",
    "check:cross-component-drift": "node scripts/checks/cross-component-drift.mjs",
    "check:animation-capabilities": "node scripts/checks/animation-capabilities.mjs",
    "check:purity": "node checks/purity.mjs",
    "check:css-tokens": "node scripts/checks/css-tokens.mjs",
    "check:css-hardcoded": "node scripts/checks/css-hardcoded.mjs",
    "check:css-transitions": "node scripts/checks/css-transitions.mjs",
    "check:prop-precedence": "node scripts/checks/prop-precedence.mjs",
    "check:control-size": "node scripts/checks/control-size.mjs",
    "check:css-important": "node scripts/checks/css-important.mjs",
    "check:internal-slot-props": "node scripts/checks/internal-slot-props.mjs",
    "check:theme-contrast": "tsx scripts/checks/theme-contrast.mjs",
    "check:component-conformance": "node scripts/checks/component-conformance.mjs",
    "check:spec-tokens": "node scripts/checks/spec-tokens.mjs",
    "check:strict-props": "node checks/strict-props.mjs",
    "check:composite-spec-drift": "node checks/composite-spec-drift.mjs",
    "check:animation-choreography": "node scripts/checks/animation-choreography.mjs",
    "check:dismissable-lifecycle": "node scripts/checks/dismissable-lifecycle.mjs",
    "check:controlled-modes": "node scripts/checks/controlled-modes.mjs",
    "check:icon-usage": "node scripts/checks/icon-usage.mjs",
    "check:conformance-docs": "node scripts/checks/conformance-docs.mjs",
    "check:conformance-spec": "node scripts/checks/conformance-spec.mjs",
    "check:rule-coverage": "node scripts/checks/rule-coverage.mjs",
    "check:wcag-evidence": "node scripts/checks/wcag-evidence.mjs",
    "check:skill-a11y-drift": "node scripts/checks/skill-a11y-drift.mjs",
    "gen:skill-a11y": "node scripts/checks/skill-a11y-drift.mjs --write",
    "check:factory-conformance": "node scripts/checks/factory-conformance.mjs",
    "check:script-refs": "node scripts/checks/script-refs.mjs",
    "check:aria-label-name": "node scripts/checks/aria-label-name.mjs",
    "check:combobox-name": "node scripts/checks/combobox-name.mjs",
    "check:integration-points": "node scripts/checks/integration-points.mjs",
    "check:data-attrs": "node scripts/checks/data-attrs.mjs",
    "check:move-props": "node scripts/checks/move-props.mjs",
    "check:component-document-drift": "node scripts/checks/component-document-drift.mjs",
    "check:doc-spec-drift": "node scripts/checks/doc-spec-drift.mjs",
    "check:all": "npm run check:spec-drift && npm run check:animation-spec-drift && npm run check:barrel-completeness && npm run check:family-popup && npm run check:family-modal && npm run check:family-disclosure && npm run check:cross-component-drift && npm run check:animation-capabilities && npm run check:purity && npm run check:css-tokens && npm run check:css-hardcoded && npm run check:css-transitions && npm run check:focus-ring-room && npm run check:prop-precedence && npm run check:control-size && npm run check:css-important && npm run check:internal-slot-props && npm run check:internal-slot-props && npm run check:theme-contrast && npm run check:component-conformance && npm run check:controlled-modes && npm run check:api-surface && npm run check:spec-tokens && npm run check:strict-props && npm run check:composite-spec-drift && npm run check:animation-choreography && npm run check:dismissable-lifecycle && npm run check:icon-usage && npm run check:conformance-docs && npm run check:conformance-spec && npm run check:rule-coverage && npm run check:wcag-evidence && npm run check:skill-a11y-drift && npm run check:factory-conformance && npm run check:script-refs && npm run check:aria-label-name && npm run check:combobox-name && npm run check:integration-points && npm run check:component-document-drift && npm run check:doc-spec-drift && npm run check:data-attrs && npm run check:move-props && npm run check:field-naming && npm run check:keyboard-entry && npm run check:design-pattern-conformance && npm run check:tokens-surface && npm run check:dist-packaging && npm run check:skill-refs && npm run check:palette-tokens && npm run check:api-compound-shape && npm run check:i18n-literals && npm run check:escape-hatch",
    "spec-diff": "tsx scripts/spec-diff/cli.mjs diff",
    "spec-snapshot": "tsx scripts/spec-diff/cli.mjs snapshot --from src/components",
    "check:focus-ring-room": "node scripts/checks/focus-ring-room.mjs",
    "check:animation-spec-drift": "node scripts/checks/animation-spec-drift.mjs"
  },
  "peerDependencies": {
    "animejs": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "animejs": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.560.0",
    "playwright": "^1.58.2",
    "prettier": "^3.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "radix-ui": "^1.1.0"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "radix",
    "animation",
    "accessible"
  ],
  "author": "Alard Weisscher (https://www.linkedin.com/in/alardweisscher)",
  "license": "MIT"
}
