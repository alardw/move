{
  "name": "move",
  "version": "0.1.26",
  "description": "Animated UI component library built on Radix UI primitives",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./system.css": "./dist/styles/system.css",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:demo": "npm run build && npm run dev & cd demo && npm run dev",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "pack": "npm version patch --no-git-tag-version && npm run build && node scripts/check-migrations.js && mkdir -p release && npm pack --pack-destination release",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "animejs": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.2.13",
    "@storybook/addon-docs": "^10.2.13",
    "@storybook/addon-onboarding": "^10.2.13",
    "@storybook/addon-vitest": "^10.2.13",
    "@storybook/react-vite": "^10.2.13",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "animejs": "^4.0.0",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "lucide-react": "^0.560.0",
    "playwright": "^1.58.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^10.2.13",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "radix-ui": "^1.1.0"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "radix",
    "animation",
    "accessible"
  ],
  "license": "MIT"
}
