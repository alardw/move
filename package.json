{
  "name": "move",
  "version": "0.1.0",
  "description": "Animated UI component library built on Radix UI primitives",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:demo": "npm run dev & cd demo && npm run dev",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "animejs": "^4.0.0",
    "lucide-react": ">=0.300.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "animejs": "^4.0.0",
    "lucide-react": "^0.560.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "radix-ui": "^1.1.0"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "radix",
    "animation",
    "accessible"
  ],
  "license": "MIT"
}
