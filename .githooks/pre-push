#!/usr/bin/env sh
# Pre-push: run the fast, deterministic CI gates locally so the common breakage
# (type errors, spec/conformance drift, formatting, failing unit tests) can't
# leave your machine red. The slow ratchets — docs a11y (axe over every sample,
# ~60s) and the Playwright browser invariants — are left to CI, which runs them
# once per push/PR rather than blocking every local push.
#
# Skip for a work-in-progress push with:  git push --no-verify

hook_start=$(date +%s)

# A gate's own output is held back and printed only if it fails. Every gate reports
# success as a wall of its own checkmarks (check:all ~30 lines, the suite ~80), which
# buries the one line worth reading. Green gets a summary; red gets everything.
#
# On a terminal each gate owns one line, counting up while it works and settling into
# its result:  ┄ move check:all… 12s   →   ✓ move check:all — 17s
# Piped or redirected (CI, `git push 2>&1 | tee log`), \r and the erase sequence would
# land as literal junk, so there the line is printed once, after the fact.

# Live path: run the gate in the background so the counter can tick while it works.
# Output has to go to a file — $(...) would block until exit, which is the thing we're
# trying to avoid. Returns the gate's exit status; leaves its output in "$log".
run_ticking() {
  desc="$1"
  shift
  "$@" >"$log" 2>&1 &
  pid=$!
  last=-1
  while kill -0 "$pid" 2>/dev/null; do
    now=$(($(date +%s) - start))
    # Poll faster than the redraw so the loop exits promptly when the gate finishes
    # (a flat `sleep 1` would add up to a second per gate), but only repaint when the
    # displayed second actually changes.
    if [ "$now" -ne "$last" ]; then
      printf '\r\033[K  ┄ %s… %ss' "$desc" "$now"
      last=$now
    fi
    sleep 0.1
  done
  wait "$pid"
}

run() {
  desc="$1"
  shift
  start=$(date +%s)
  status=0

  if [ -t 1 ]; then
    log=$(mktemp)
    run_ticking "$desc" "$@" || status=$?
    out=$(cat "$log")
    rm -f "$log"
    printf '\r\033[K'
  else
    out=$("$@" 2>&1) || status=$?
  fi

  elapsed=$(($(date +%s) - start))
  if [ "$status" -ne 0 ]; then
    printf '  ✗ %s — FAILED after %ss\n\n' "$desc" "$elapsed"
    printf '%s\n\n' "$out"
    echo "    fix it, or push a work-in-progress branch with: git push --no-verify"
    exit 1
  fi
  printf '  ✓ %s — %ss\n' "$desc" "$elapsed"
}

echo "▶ pre-push: Move"
run "move typecheck" npm run typecheck --workspace move --silent
run "move lint" npm run lint --workspace move --silent -- --quiet
run "move format:check" npm run format:check --workspace move --silent
run "move check:all" npm run check:all --workspace move --silent
run "move tests" npm run test --workspace move --silent

echo "▶ pre-push: Docs"
run "docs typecheck" npm run typecheck --workspace docs --silent
run "docs conformance" npm run check:conformance --workspace docs --silent

printf '✓ pre-push: all gates green in %ss (a11y + browser run in CI) — safe to push\n' \
  "$(($(date +%s) - hook_start))"
