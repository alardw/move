#!/usr/bin/env sh
# Pre-commit: keep Move specs ↔ source ↔ schema in sync, and recipes/samples pure.
# Scoped per area so unrelated commits (config, docs prose) stay instant.

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# --- Move components/specs: spec-drift + typecheck + strict-props ---
if printf '%s\n' "$staged" | grep -qE '^packages/move/src/components/.*\.(tsx|ts)$'; then
  echo "▶ pre-commit: Move components/specs changed — spec ↔ source ↔ schema + strict-props…"

  if ! npm run check:spec-drift --workspace move --silent; then
    echo "✗ spec-drift: a spec is out of sync with its source. Fix the spec (or the source)."
    exit 1
  fi

  if ! npm run typecheck --workspace move --silent; then
    echo "✗ typecheck: a spec no longer satisfies ComponentSpec, or the source has a type error."
    exit 1
  fi

  if ! npm run check:strict-props --workspace move --silent; then
    echo "✗ strict-props: a component Props interface uses 'extends Record<string, unknown>'. Use React HTML attrs."
    exit 1
  fi

  # The declarations live in the specs, so a component change can break a
  # contract without touching the registry. Both directions: a declared
  # capability that no longer holds, and behaviour that stopped declaring one.
  if ! npm run check:capabilities --workspace move --silent; then
    echo "✗ capabilities: a declared contract no longer holds, or source exhibits one it doesn't declare."
    exit 1
  fi

  if ! npm run check:families --workspace move --silent; then
    echo "✗ families: a member no longer keeps its family's contract."
    exit 1
  fi

  if ! npm run check:required-children --workspace move --silent; then
    echo "✗ required-children: a compound part is missing one it can't work without (and fails silently)."
    exit 1
  fi

  echo "✓ component checks passed"
fi

# --- The contract registries themselves ---
# Editing these changes what every member is held to, so both directions run
# whatever else is staged. They also validate the registry: a capability with no
# declaring component enforces nothing, and a target that isn't a real SlotKind
# applies to nothing at all.
if printf '%s\n' "$staged" | grep -qE '^packages/move/src/(capabilities|families)\.ts$'; then
  echo "▶ pre-commit: contract registry changed — capabilities + families…"

  if ! npm run check:capabilities --workspace move --silent; then
    echo "✗ capabilities: see above. A capability with no members enforces nothing — declare it or drop it."
    exit 1
  fi

  if ! npm run check:families --workspace move --silent; then
    echo "✗ families: a member no longer keeps its family's contract."
    exit 1
  fi

  echo "✓ contract registry checks passed"
fi

# --- Component CSS: the shared option definition ---
if printf '%s\n' "$staged" | grep -qE '^packages/move/src/components/.*\.module\.css$'; then
  echo "▶ pre-commit: component CSS changed — shared option rows…"

  if ! npm run check:option-rows --workspace move --silent; then
    echo "✗ option-rows: a keyboard-highlightable row is styled outside --move-option-*. Redefine the token, don't inline a value."
    exit 1
  fi

  echo "✓ option-row checks passed"
fi

# --- Recipe / docs-sample sources: purity + recipe spec↔source drift ---
if printf '%s\n' "$staged" | grep -qE '^packages/docs/src/content/(recipes|components)/.*\.(tsx|ts)$|^packages/move/skills/references/recipes/composite/.*\.tsx$'; then
  echo "▶ pre-commit: recipe/sample sources changed — recipe purity + spec drift…"

  if ! npm run check:purity --workspace move --silent; then
    echo "✗ recipe-purity: inline styles, raw HTML, or non-Move components. Use Move components + their props."
    exit 1
  fi

  if ! npm run check:composite-spec-drift --workspace move --silent; then
    echo "✗ composite-spec-drift: a composite's composition/labels are out of sync with its .spec.ts."
    exit 1
  fi

  echo "✓ composite checks passed"
fi

# --- Move src: Prettier (auto-fix, re-stage) + ESLint on staged files only ---
# Scoped to what's staged so the hook stays fast; whole-repo format/lint run in CI.
staged_move=$(printf '%s\n' "$staged" | grep -E '^packages/move/src/.*\.(ts|tsx|css)$' || true)
if [ -n "$staged_move" ]; then
  echo "▶ pre-commit: formatting + linting staged Move source…"

  # Auto-format staged files and re-stage them (lint-staged style). Paths are
  # passed relative to the package so its .prettierrc / eslint.config.mjs apply.
  rel=$(printf '%s\n' "$staged_move" | sed 's#^packages/move/##')
  ( cd packages/move && printf '%s\n' "$rel" | xargs npx prettier --write ) || { echo "✗ prettier failed."; exit 1; }
  printf '%s\n' "$staged_move" | xargs git add

  # Lint staged TS/TSX — anything ESLint reports blocks the commit.
  rel_lint=$(printf '%s\n' "$rel" | grep -E '\.(ts|tsx)$' || true)
  if [ -n "$rel_lint" ]; then
    # --max-warnings 0: the package is at zero, and a warning nobody acts on is
    # noise that buries the real ones. If a metric rule is measuring the wrong
    # thing for a file's shape, change the rule in eslint.config.mjs with a
    # reason — that is a decision in one reviewable place, not a disable comment
    # per site.
    if ! ( cd packages/move && printf '%s\n' "$rel_lint" | xargs npx eslint --max-warnings 0 ); then
      echo "✗ eslint: staged Move source has lint problems. Fix them (warnings count)."
      exit 1
    fi
  fi

  echo "✓ format + lint passed"
fi

# --- Docs source: format only ---
# Docs has no ESLint config of its own, so this is the formatter alone. It exists
# because docs sat outside every format gate and drifted to Prettier's DEFAULTS —
# double quotes, 80 columns — against the repo's .prettierrc.json. That is
# invisible until someone with format-on-save edits a file and reformats half of
# it around their one-line change.
staged_docs=$(printf '%s\n' "$staged" | grep -E '^packages/docs/src/.*\.(ts|tsx|css)$' || true)
if [ -n "$staged_docs" ]; then
  echo "▶ pre-commit: formatting staged docs source…"
  rel_docs=$(printf '%s\n' "$staged_docs" | sed 's#^packages/docs/##')
  ( cd packages/docs && printf '%s\n' "$rel_docs" | xargs npx prettier --write --ignore-path ../../.prettierignore ) || { echo "✗ prettier failed."; exit 1; }
  printf '%s\n' "$staged_docs" | xargs git add
  echo "✓ docs format passed"
fi
